{
  "name": "tickr-react-native",
  "version": "0.1.0",
  "private": true,
  "description": "Tickr, reimplemented in React Native. Same product, different mental model.",
  "workspaces": [
    "apps/*",
    "packages/core/*",
    "packages/features/*/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react-native-reanimated": "4.1.7",
    "react-native-worklets": "0.8.3"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "mobile": "npm run start --workspace=@tickr/mobile",
    "web": "npm run web --workspace=@tickr/mobile",
    "ios": "npm run ios --workspace=@tickr/mobile",
    "android": "npm run android --workspace=@tickr/mobile"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "eslint": "9.36.0",
    "eslint-plugin-boundaries": "5.0.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "6.1.0",
    "prettier": "3.6.2",
    "react-native-reanimated": "4.1.7",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0",
    "vitest": "3.2.4"
  },
  "packageManager": "npm@10.9.2"
}
